@startuml DFD_L2_Order
skinparam rectangle { BackgroundColor #EFF6FF; BorderColor #3B82F6 }
skinparam database { BackgroundColor #F0FDF4; BorderColor #16A34A }

actor "Khách hàng" as C
actor "Cổng TT\n(VNPay/MoMo\n/ZaloPay)" as GW

rectangle "P1.1\nTạo đơn hàng\nPOST /api/v1/orders\n→ status: pending_payment\n→ generate_order_number()" as P11 #DBEAFE
rectangle "P1.2\nKhởi tạo thanh toán\nPOST /api/v1/orders/[id]/pay\n→ PaymentService.createPayment()\n→ payment URL" as P12 #DBEAFE
rectangle "P1.3\nXử lý kết quả TT\n(IPN Webhooks)\n/api/webhooks/vnpay\n/api/webhooks/momo\n/api/webhooks/zalopay" as P13 #FEF9C3

rectangle "P1.4a\nXác nhận PAID\n→ UPDATE orders SET status=paid\n→ reserve_order_stock() RPC\n→ trừ stock_qty (atomic)\n→ INSERT inventory_movements" as P14a #DCFCE7

rectangle "P1.4b\nHủy / Thất bại\n→ UPDATE orders SET status=cancelled\n→ Stock KHÔNG bị trừ\n(chưa reserve trước)" as P14b #FEE2E2

rectangle "P1.5\nMembership Trigger\ntrg_order_status_change\n→ update_membership_tier()" as P15 #F3E8FF

database "orders\n(status: pending_payment\n→ paid / cancelled)" as DO
database "payments\npayment_events\n(idempotency: gateway_event_id UNIQUE)" as DP
database "product_variants\n(stock_qty)" as DV
database "inventory_movements\n(delta, reason, reference_order_id)" as DM
database "profiles\n(membership_tier)" as DPR
database "admin_audit_logs" as DAL

C --> P11 : Cart items + địa chỉ giao
P11 --> DO : INSERT order + order_items
P11 --> C : order_id

C --> P12 : order_id + provider\n(vnpay/momo/zalopay/cod)
P12 --> DP : INSERT payments (pending)
P12 --> C : paymentUrl (redirect)

GW --> P13 : IPN Webhook\n(gateway_event_id để chống duplicate)
P13 --> DP : UPDATE payment_events.processed=true

P13 --> P14a : Payment COMPLETED
P14a --> DO : UPDATE status='paid'
P14a --> DV : reserve_order_stock() RPC\n(UPDATE WHERE stock_qty >= qty)
P14a --> DM : INSERT movement (delta=-qty)
P14a --> P15

P15 --> DPR : UPDATE membership_tier\n(standard/silver/gold/platinum/vip)

P13 --> P14b : Payment FAILED/CANCELLED
P14b --> DO : UPDATE status='cancelled'

P14a --> DAL : logAdminAction\n(order.status_update)

@enduml