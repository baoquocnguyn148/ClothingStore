@startuml ERD_BnD
hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontSize 10
}

entity "**auth.users**\n(Supabase Auth)" as AUTH {
  * id : UUID <<PK>>
  --
  email : TEXT
  encrypted_password : TEXT
}

entity "**profiles**" as PROF {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK auth.users>>
  full_name : TEXT
  phone : TEXT
  membership_tier : TEXT
  role : user_role
}

entity "**addresses**" as ADDR {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK auth.users>>
  address_line : TEXT
  city : TEXT
  is_default : BOOLEAN
}

entity "**collections**" as COL {
  * id : UUID <<PK>>
  --
  handle : TEXT <<UNIQUE>>
  title : TEXT
  published : BOOLEAN
}

entity "**products**" as PROD {
  * id : UUID <<PK>>
  --
  handle : TEXT <<UNIQUE>>
  title : TEXT
  base_price : INT
  compare_at_price : INT
  category : TEXT
  published : BOOLEAN
}

entity "**product_variants**\n★ stock_qty: kho thực tế" as PVAR {
  * id : UUID <<PK>>
  --
  product_id : UUID <<FK products>>
  sku : TEXT <<UNIQUE>>
  size : TEXT
  color_name : TEXT
  price : INT
  stock_qty : INT
  is_active : BOOLEAN
}

entity "**product_images**" as PIMG {
  * id : UUID <<PK>>
  --
  product_id : UUID <<FK products>>
  url : TEXT
  sort_order : INT
}

entity "**tags**" as TAGS {
  * id : UUID <<PK>>
  --
  slug : TEXT <<UNIQUE>>
  label : TEXT
}

entity "**product_tag_assignments**" as PTA {
  * product_id : UUID <<FK>>
  * tag_id : UUID <<FK>>
}

entity "**collection_products**" as CP {
  * collection_id : UUID <<FK>>
  * product_id : UUID <<FK>>
  sort_order : INT
}

entity "**carts**" as CART {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK auth.users>>
  guest_session_id : TEXT
}

entity "**cart_items**" as CI {
  * id : UUID <<PK>>
  --
  cart_id : UUID <<FK carts>>
  variant_id : UUID <<FK product_variants>>
  quantity : INT
  unit_price : INT
}

entity "**wishlist_items**" as WISH {
  * user_id : UUID <<FK>>
  * product_id : UUID <<FK>>
}

entity "**orders**\n(status: draft→pending_payment→\npaid→confirmed→shipping→delivered\n→cancelled/refunded)" as ORD {
  * id : UUID <<PK>>
  --
  order_number : TEXT <<UNIQUE>>
  user_id : UUID <<FK auth.users>>
  status : order_status
  subtotal : INT
  shipping_fee : INT
  discount_amount : INT
  total : INT
  shipping_address : JSONB
  promotion_id : UUID <<FK promotions>>
}

entity "**order_items**" as OI {
  * id : UUID <<PK>>
  --
  order_id : UUID <<FK orders>>
  variant_id : UUID <<FK product_variants>>
  product_title : TEXT
  unit_price : INT
  quantity : INT
}

entity "**order_status_logs**" as OSL {
  * id : UUID <<PK>>
  --
  order_id : UUID <<FK orders>>
  from_status : order_status
  to_status : order_status
  note : TEXT
}

entity "**payments**" as PAY {
  * id : UUID <<PK>>
  --
  order_id : UUID <<FK orders>>
  provider : payment_provider
  status : payment_status
  amount : INT
  transaction_ref : TEXT
}

entity "**payment_events**\n(Idempotency key)" as PEV {
  * id : UUID <<PK>>
  --
  payment_id : UUID <<FK payments>>
  gateway_event_id : TEXT <<UNIQUE>>
  payload : JSONB
  processed : BOOLEAN
}

entity "**inventory_movements**\n(audit trail tồn kho)" as INV {
  * id : UUID <<PK>>
  --
  variant_id : UUID <<FK product_variants>>
  delta : INT
  reason : TEXT
  actor_id : UUID <<FK auth.users>>
  reference_order_id : UUID <<FK orders>>
}

entity "**promotions**" as PROMO {
  * id : UUID <<PK>>
  --
  code : TEXT <<UNIQUE>>
  type : promotion_type
  value : INT
  min_order_value : INT
  starts_at : TIMESTAMPTZ
  expires_at : TIMESTAMPTZ
}

entity "**shipping_zones**" as SHIP {
  * id : UUID <<PK>>
  --
  name : TEXT
  provinces : TEXT[]
  fee : INT
  free_above : INT
}

entity "**admin_audit_logs**" as AUD {
  * id : UUID <<PK>>
  --
  actor_id : UUID <<FK auth.users>>
  action : TEXT
  entity : TEXT
  entity_id : TEXT
  metadata : JSONB
}

entity "**admin_notifications**" as NOTIF {
  * id : UUID <<PK>>
  --
  type : TEXT
  title : TEXT
  entity : TEXT
  entity_id : UUID
  read : BOOLEAN
}

entity "**crm_notes**" as CRMN {
  * id : UUID <<PK>>
  --
  customer_user_id : UUID <<FK>>
  body : TEXT
}

entity "**crm_tasks**" as CRMT {
  * id : UUID <<PK>>
  --
  customer_user_id : UUID <<FK>>
  status : crm_task_status
  priority : crm_task_priority
}

entity "**crm_tickets**" as CRMTK {
  * id : UUID <<PK>>
  --
  customer_user_id : UUID <<FK>>
  order_id : UUID <<FK orders>>
  status : crm_ticket_status
}

entity "**crm_campaigns**" as CRMC {
  * id : UUID <<PK>>
  --
  segment_id : UUID <<FK crm_segments>>
  status : crm_campaign_status
  channel : TEXT
}

entity "**blog_posts**" as BLOG {
  * id : UUID <<PK>>
  --
  slug : TEXT <<UNIQUE>>
  title : TEXT
  published : BOOLEAN
}

' Relationships
AUTH ||--|| PROF
AUTH ||--o{ ADDR
AUTH ||--o{ CART
AUTH ||--o{ ORD

PROD ||--|{ PVAR
PROD ||--o{ PIMG
PROD }|--|{ TAGS : via product_tag_assignments
PROD }|--|{ COL : via collection_products
PVAR ||--o{ CI
PVAR ||--o{ OI
PVAR ||--o{ INV

CART ||--|{ CI

ORD ||--|{ OI
ORD ||--o{ OSL
ORD ||--|{ PAY
PAY ||--o{ PEV
ORD ||--o{ INV : reference_order_id

PROMO ||--o{ ORD

AUTH ||--o{ CRMN : customer_user_id
AUTH ||--o{ CRMT : customer_user_id
AUTH ||--o{ CRMTK : customer_user_id
ORD ||--o{ CRMTK

BLOG }|--|{ PROD : via blog_post_products

@enduml