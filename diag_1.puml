@startuml DFD_L0
skinparam rectangle {
  BackgroundColor #DBEAFE
  BorderColor #2563EB
}
skinparam database {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
}

rectangle "Khách hàng" as C
rectangle "Nhân viên Admin" as A
rectangle "Ban Giám đốc" as E
rectangle "Cổng Thanh Toán\n(VNPay / MoMo / ZaloPay)" as P

database "B&D MIS System\n(Next.js App + Supabase PostgreSQL)" as SYS

C --> SYS : Thông tin đăng ký, đơn hàng,\ngỏ hàng, mã giảm giá
SYS --> C : Trạng thái đơn, xác nhận\nthanh toán, URL redirect

A --> SYS : Cập nhật SP, tồn kho,\nxử lý đơn hàng, quản lý CRM
SYS --> A : Báo cáo doanh thu, cảnh báo\ntồn kho, thông báo mới

E --> SYS : Yêu cầu báo cáo KPI,\nphân tích xu hướng
SYS --> E : Dashboard MIS/DSS/ESS,\nRFM segments, revenue chart

SYS --> P : Tạo payment URL\n(transaction_ref)
P --> SYS : IPN Webhook callback\n(vnpay/momo/zalopay)

@enduml